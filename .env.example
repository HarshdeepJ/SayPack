# Copy to .env.local (never committed) and fill in. Restart `npm start` after changes.

# Voice uses a free mock unless this is "gemini".
SAYPACK_AI_PROVIDER=mock

# Required when SAYPACK_AI_PROVIDER=gemini. Server-side only; never sent to browsers.
GEMINI_API_KEY=

# Optional. Default: gemini-3.5-flash-lite. Add new models to MODEL_PRICING in src/domain/ai.ts first.
# SAYPACK_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional thinkingConfig.thinkingLevel (thinking tokens are billed as output). Leave unset unless verified.
# SAYPACK_GEMINI_THINKING=minimal

# Mock only: treat every recorded clip as this text, to rehearse the voice flow on a phone.
# SAYPACK_MOCK_AUDIO_TEXT=Blue vase, fragile, no visible damage
